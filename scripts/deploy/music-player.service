[Unit]
Description=Music Player Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=music-player
Group=music-player
WorkingDirectory=/opt/music-player/current
ExecStart=/opt/music-player/current/music-player --config /etc/music-player/config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/music-player
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
